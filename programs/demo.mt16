.thread 0
    # Programs initialize their own constants, so the Logisim RAM can reset to zero.
    LDI 1
    ST 0x01
    LDI 11
    ST 0x0b
    LDI 0
    ST 0x10
    LDI 1
    ST 0x11
sum_loop:
    LD 0x10
    ADD 0x11
    ST 0x10
    LD 0x11
    ADD 0x01
    ST 0x11
    SUB 0x0b
    JZ sum_done
    JMP sum_loop
sum_done:
    LD 0x10
    ST 0xf0
    LDI 1
    ATOMADD 0x30
    HALT

.thread 1
    LDI 0xff
    ST 0x02
    LDI 0xaa
    ST 0x20
    LDI 0x0f
    OR 0x20
    XOR 0x20
    NOT
    AND 0x02
    ST 0xf1
    LDI 1
    ATOMADD 0x30
    HALT

.thread 2
    LDI 3
    SHL
    SHL
    SHL
    SHL
    SHR
    ST 0xf2
    LDI 1
    ATOMADD 0x30
    HALT

.thread 3
    LDI 40
    ST 0x21
    LDI 2
    ADD 0x21
    ST 0xf3
    LDI 1
    ATOMADD 0x30
    HALT
